; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SpotlightGameJam"
run/main_scene="res://Code/Entities/TestWorld/TestWorld.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Util="*uid://b1hvelunefia2"
SignalBus="*uid://cys1wmnhxscfl"
ExportSettings="*uid://bqckn4tk862os"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
GlobalValue="*res://Code/Autoloads/GlobalValue.gd"
PhantomCameraManager="*uid://duq6jhf6unyis"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

movie_writer/movie_file="/Users/night/Desktop/SpotlightGameJam/Movie/test.avi"
movie_writer/fps=120

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

