[gd_scene format=3 uid="uid://kltw4unihbsh"]

[ext_resource type="Script" uid="uid://dtsf0m778x60b" path="res://Code/Entities/Plot/Chapter1.gd" id="1_chapter"]
[ext_resource type="PackedScene" uid="uid://bufrvjp0xqq8m" path="res://Code/Entities/InteractiveComponent/InteractableComponent/InteractableComponent.tscn" id="2_trigger"]
[ext_resource type="Script" uid="uid://bfra5n80onwqv" path="res://Code/Entities/Plot/PlotDialogLine.gd" id="3_line"]

[sub_resource type="Resource" id="Line_1_1"]
script = ExtResource("3_line")
dialog_type = "独白"
text = "这是哪里……"

[sub_resource type="Resource" id="Line_1_2"]
script = ExtResource("3_line")
dialog_type = "独白"
text = "好痛……身体像被火烧过一样……水，我需要水！"

[sub_resource type="Resource" id="Line_1_3"]
script = ExtResource("3_line")
text = "【靠近水源可快速补充水分】"

[sub_resource type="Resource" id="Line_1_4"]
script = ExtResource("3_line")
text = "冰凉舒缓的水滑入喉管。"

[sub_resource type="Resource" id="Line_1_5"]
script = ExtResource("3_line")
dialog_type = "独白"
text = "慢慢找回呼吸的节奏了，刚刚那种心脏快要干涸的感觉消失了……"

[sub_resource type="Resource" id="Line_1_6"]
script = ExtResource("3_line")
dialog_type = "独白"
text = "虽然不知道为什么，但看来得一直保持身体里的水分才行，一旦缺水，恐怕行动都会成问题。"

[sub_resource type="Resource" id="Line_1_7"]
script = ExtResource("3_line")
text = "水面的涟漪倒映出一张完全陌生的脸。"

[sub_resource type="Resource" id="Line_1_8"]
script = ExtResource("3_line")
dialog_type = "独白"
text = "这，这是我吗……脸上是什么……"

[sub_resource type="Resource" id="Line_1_9"]
script = ExtResource("3_line")
dialog_type = "独白"
text = "这帐篷……是用无数片颜色各异的碎布料拼凑缝补的。有人在这里生活过？"

[sub_resource type="Resource" id="Line_1_12"]
script = ExtResource("3_line")
text = "残破的石碑，上方一行字，下方有刻痕形成的图案，经历了风吹日晒，还附着着很多沙土，均已有些模糊不清。图案是几个火柴人影，看起来像是高举手臂，整个身体向上延伸（其实是幻化成云的过程）；天上的云；短而粗劣的竖向线条（其实是雨）。"

[sub_resource type="Resource" id="Line_1_13"]
script = ExtResource("3_line")
dialog_type = "独白"
text = "这上面有字，“寻找，直到最后XXXXX。”好难辨认，后面几个字几乎看不清了啊。
还有……这是一幅画吗？画上的人在干什么，好像在朝着远处挥手？这些竖道又是什么……"

[sub_resource type="Resource" id="Line_1_14"]
script = ExtResource("3_line")
dialog_type = "独白"
text = "这是谁留下的，为什么偏偏出现在这里？他似乎知道些什么……难道他也曾像我一样，不知何去何从……"

[sub_resource type="Resource" id="Line_1_15"]
script = ExtResource("3_line")
dialog_type = "独白"
text = "不管怎样，看来我只能沿着这些线索继续走下去了。那么，先去画上人挥手的方向看看吧"

[node name="Chapter1" type="Node2D" unique_id=1252895089]
script = ExtResource("1_chapter")
opening_lines = Array[ExtResource("3_line")]([SubResource("Line_1_1"), SubResource("Line_1_2")])

