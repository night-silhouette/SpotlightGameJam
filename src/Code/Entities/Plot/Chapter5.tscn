[gd_scene load_steps=29 format=3]

[ext_resource type="Script" path="res://Code/Entities/Plot/Chapter5.gd" id="1"]
[ext_resource type="PackedScene" path="res://Code/Entities/InteractiveComponent/InteractableComponent/InteractableComponent.tscn" id="2"]
[ext_resource type="Script" path="res://Code/Entities/Plot/PlotDialogLine.gd" id="3"]

[sub_resource type="RectangleShape2D" id="area"]
size = Vector2(150, 100)

[sub_resource type="Resource" id="5_1"]
script = ExtResource("3")
text = "水脉终将带着所有被遗忘的名字\n回到世界的出处"

[sub_resource type="Resource" id="5_2"]
script = ExtResource("3")
text = "沙丘的尽头，那片熟悉的水面终于再次出现在眼前，仍旧安静地嵌在沙地之间。"

[sub_resource type="Resource" id="5_3"]
script = ExtResource("3")
dialog_type = "独白"
text = "还记得我第一次睁开眼睛时的情形。我曾以为，只要沿着线索走下去，总有一天能找到属于自己的过去。可走到现在，我找到的不是自己的记忆，而是两个族群留下的漫长历史。"

[sub_resource type="Resource" id="5_4"]
script = ExtResource("3")
text = "信物立刻沉入水中，水面荡开一圈涟漪。片刻之后，水底浮现出微弱的光。那光并不刺眼，只在水下缓缓流动，沿着看不见的纹路向四周延伸。"

[sub_resource type="Resource" id="5_5"]
script = ExtResource("3")
text = "指尖忽然传来一阵异样的感觉。低下头，发现自己的身体边缘正变得模糊。细小的水汽从皮肤表面缓缓升起，悬浮在身体周围。"

[sub_resource type="Resource" id="5_7"]
script = ExtResource("3")
text = "他将两只手交握，想确认这感觉是否只是错觉。可手掌的轮廓也在一点点淡去。情急之下，向后退去，退到帐篷边时，发现身体的变化停止了，只不过还有很多水汽飘荡在四周。"

[sub_resource type="Resource" id="5_6"]
script = ExtResource("3")
dialog_type = "独白"
text = "我这是怎么了？"

[sub_resource type="Resource" id="5_8"]
script = ExtResource("3")
text = "水面上的光逐渐增多，与主角身体周围悬浮的水汽彼此呼应。心中疑惑，四下张望。"

[sub_resource type="Resource" id="5_9"]
script = ExtResource("3")
text = "水汽掠过残碑，附着在冰冷的石面上，凝成细密的水珠。水珠沿着凹陷的刻痕缓缓滑落，尘土被浸湿，原本模糊的线条逐渐显露出来。原本不成意义的图案，终于连成了一幅完整的画。"

[sub_resource type="Resource" id="5_10"]
script = ExtResource("3")
text = "最初，他以为那些人是在朝远方挥手，或是在做某种祈求的仪式；此刻他才发现，那些身影的轮廓并非伸展，而是在逐渐消散，升上天空，就和他现在一样。它们化作水汽，升入云中，最终成为落向大地的雨。水珠顺着石刻的纹路继续下滑，形成一道水流，汇入水池。他低下头，看见自己的身影已经半透明。石碑上的图案与此刻发生的一切，重叠在了一起。"

[sub_resource type="Resource" id="5_11"]
script = ExtResource("3")
dialog_type = "独白"
text = "（猛然警觉）那是……那是雨……那些刻痕，是雨……那些人影也不是在挥手，是在上升，和我现在一样，直到……（情不自禁地读出残碑上变清晰的字）直到最后一场雨落下。"

[sub_resource type="Resource" id="5_12"]
script = ExtResource("3")
text = "一阵风吹过。水池上方，忽然浮现出一道模糊的身影。那身影站在池边，低头看着水面，随后缓缓抬起头。主角看不清它的面容，只看见它的身体逐渐消散，升向天空。"

[sub_resource type="Resource" id="5_13"]
script = ExtResource("3")
text = "幻影在水池周围不断闪现。有的久久凝望水面，有的席地而坐，有的回望身后的沙漠。一个身影消失，另一个又苏醒。"

[sub_resource type="Resource" id="5_14"]
script = ExtResource("3")
text = "一个个身影化身为一片片云，换来了一场场雨。幻影中的天空一次次变幻。有时云层聚拢，雨很短暂，有时雨水刚刚渗入沙土，便被烈日蒸干。"

[sub_resource type="Resource" id="5_15"]
script = ExtResource("3")
dialog_type = "独白"
text = "难怪……\n蓄水池里的水，深埋地下的水脉，还有那片湖……为什么他们没有在那次极昼灾难中干涸，都是因为他们幻化作的这一片又一片的云。\n真奇妙啊，他们走过相似的道路，又在这里作出了自己的选择，尽管他们无法知道自己究竟改变了什么，永远也见不到这片土地最终的模样。"

[sub_resource type="Resource" id="5_16"]
script = ExtResource("3")
text = "那句文字静静留在石面上。自己没有得到任何承诺。不知道自己会变成怎样的云，也不知道这场雨将落向何处。"

[sub_resource type="Resource" id="5_17"]
script = ExtResource("3")
dialog_type = "独白"
text = "一场雨或许微不足道，哪无数场雨呢，无数滴水呢？"

[sub_resource type="Resource" id="5_18"]
script = ExtResource("3")
text = "缓缓松开紧握的手。他不再试图抓住正在消散的身体，而是抬起头，望向天空。最后一缕犹豫随着呼吸散去。他向前迈出一步，水汽从脚下升起，托起逐渐消散的身躯。他的身体终于完全化作水汽，融入升起的雾中。"

[sub_resource type="Resource" id="5_19"]
script = ExtResource("3")
text = "身体，如果还能称为身体的话，升入高空。他看见了无数曾经的身影，他们早已不再拥有身体，现下只是彼此交融的云雾。它们没有名字，也不再区分彼此来自白昼还是黑夜。他闭上眼，感觉风将他推向远方。"

[sub_resource type="Resource" id="5_20"]
script = ExtResource("3")
text = "云层不断向远方延伸。高空中传来一阵低沉的声响，细小的水珠沿着云雾缓缓聚集。"

[sub_resource type="Resource" id="5_21"]
script = ExtResource("3")
text = "一滴雨穿过云层，落向干涸的沙地。随后，第二滴、第三滴接连坠落。把帐篷，还有他留在帐篷前的斗篷都打湿了。"

[sub_resource type="Resource" id="5_22"]
script = ExtResource("3")
text = "雨水渐渐连成一片，落在宫殿和图书馆的残垣上，也落在那片曾经埋葬着无数骸骨的绿洲里。雨水落入泥土，沿着草木的根须缓缓渗下。那些从骸骨之间生长出来的植物，在雨中欢快地摇曳着。"

[sub_resource type="Resource" id="5_23"]
script = ExtResource("3")
text = "水池里的水面微微上涨，水面映出厚重的云层，也映出连绵不绝的雨。雨声中，水池与天空之间，仿佛有一条看不见的线，将它们连接起来。"

[sub_resource type="Resource" id="5_24"]
script = ExtResource("3")
text = "伴随着水池满溢向外翻涌的一瞬画面，故事结束。"

