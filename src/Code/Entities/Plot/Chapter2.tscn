[gd_scene load_steps=26 format=3]

[ext_resource type="Script" path="res://Code/Entities/Plot/Chapter2.gd" id="1"]
[ext_resource type="PackedScene" path="res://Code/Entities/InteractiveComponent/InteractableComponent/InteractableComponent.tscn" id="2"]
[ext_resource type="Script" path="res://Code/Entities/Plot/PlotDialogLine.gd" id="3"]

[sub_resource type="RectangleShape2D" id="area"]
size = Vector2(160, 120)

[sub_resource type="Resource" id="2_1"]
script = ExtResource("3")
text = "太阳在沙丘上留下了无名的城"

[sub_resource type="Resource" id="2_2"]
script = ExtResource("3")
text = "一座破败的宫殿半埋于炙热的黄沙之中。高大的石墙早已倾颓，断裂的石柱仍倔强地撑起残存的穹顶，但仍能看出这里旧日的恢宏。墙边留存着几处规整的蓄水池与水道。"

[sub_resource type="Resource" id="2_3"]
script = ExtResource("3")
dialog_type = "独白"
text = "这宫殿即使已经残破，依然能看出昔日的辉煌。"

[sub_resource type="Resource" id="2_5"]
script = ExtResource("3")
text = "许多陶罐。堆在墙角与石阶旁，大小不一，形制各异，罐身残留着褪色的纹饰。部分已经干燥破裂，边缘参差，裂纹密布。"

[sub_resource type="Resource" id="2_6"]
script = ExtResource("3")
dialog_type = "独白"
text = "这么多陶罐碎片，是用来储水的吧……曾经是。"

[sub_resource type="Resource" id="2_7"]
script = ExtResource("3")
text = "一些工具与农具散落在残墙边，长柄木器已朽坏，金属部分覆着厚厚的锈迹，边缘均已磨损。它们曾被频繁使用，如今却静静地躺在沙土之中。"

[sub_resource type="Resource" id="2_8"]
script = ExtResource("3")
dialog_type = "独白"
text = "这些工具和农具，有些形制简单，有些已有精巧的结构……不仅建造了这样庞大的宫殿，还曾开辟土地、耕种作物。在这片沙漠里要做到这些，并不容易。"

[sub_resource type="Resource" id="2_10"]
script = ExtResource("3")
text = "沿着高大的墙面铺展开的壁画。残缺不全。\n画中，日族（蛇样）在烈日下筑起高墙，建造宫殿与蓄水设施。\n另一侧，日族战士列阵出征，旌旗与兵刃交错。\n画面逐渐延伸，接连几幅都是在描绘战场情景，日月轮换，晴雨交替，战役从白昼持续到黑夜，又从黑夜延续至白昼。\n再往下，很多日族的民众聚在一起，围着宫殿，庆祝着什么。\n最后一幅，映入眼帘的是一轮巨大的、比例失调的，甚至有些畸形的太阳，将原本的城池和族民都挤压到了底边。"

[sub_resource type="Resource" id="2_11"]
script = ExtResource("3")
dialog_type = "独白"
text = "奇怪……壁画怎么突然断了？\n这太阳……让人有一种很不安的感觉，像是要将一切吞没。"

[sub_resource type="Resource" id="2_12"]
script = ExtResource("3")
text = "一堆铭牌散落在石桌边。边上刻着相似的纹饰与文字，部分铭文仍能辨认：日族先锋军。"

[sub_resource type="Resource" id="2_13"]
script = ExtResource("3")
dialog_type = "独白"
text = "这是为战死者准备的哀荣……怎么都堆在这里，没有分发出去呢？"

[sub_resource type="Resource" id="2_14"]
script = ExtResource("3")
text = "一张巨大的石桌。横亘在宫殿中央，桌面覆着一层厚重的沙土。桌沿雕刻着繁复的日轮纹饰，几处边角已经有崩裂的趋势。\n桌面一侧有一片不自然的擦痕，露出了光滑的石面。"

[sub_resource type="Resource" id="2_15"]
script = ExtResource("3")
dialog_type = "独白"
text = "像是他们开会议事的地方。这里曾经有着相当完善的制度啊。"

[sub_resource type="Resource" id="2_17"]
script = ExtResource("3")
text = "一尊蛇身雕塑。矗立在石台之上，颜色已经被磨损殆尽，但轮廓完整。蛇身盘踞，昂首向天，充满神秘的压迫感。这是这片废墟里唯一保有完整形态的造物。"

[sub_resource type="Resource" id="2_18"]
script = ExtResource("3")
dialog_type = "独白"
text = "这地方到处是积尘，怎么这尊雕塑上却干干净净……咦？尾巴好像还被人反复修缮过。"

[sub_resource type="Resource" id="2_19"]
script = ExtResource("3")
dialog_type = "独白"
text = "啊！雕塑头顶的纹饰，和我脸上的一模一样……"

[sub_resource type="Resource" id="2_20"]
script = ExtResource("3")
text = "一顶日轮冠。嵌在蛇身雕塑的头顶，仍保留着精巧而庄严的形制，冠体金色，纹饰层层舒展。"

[sub_resource type="Resource" id="2_21"]
script = ExtResource("3")
dialog_type = "独白"
text = "这似乎不是普通的装饰。它被如此郑重地安置在这里，还散发着一种说不清道不明的力量……\n先带走吧，说不定之后会用得到。"

[sub_resource type="Resource" id="2_22"]
script = ExtResource("3")
text = "位于高处的巨型蓄水池发出一声低沉而绝望的轰鸣，竟突然崩塌。石板接连断裂，积蓄已久的水伴随着沙土与碎石倾泻而下，四周的地板随之急剧破裂，轰鸣声在空旷的城池间回荡。"

[sub_resource type="Resource" id="2_23"]
script = ExtResource("3")
dialog_type = "独白"
text = "得快点躲开！\n这么多水，怎么会，这座城不是已经荒废了吗？"

[sub_resource type="Resource" id="2_25"]
script = ExtResource("3")
text = "我曾以为世界的苦难源于缺少，缺少水，缺少土地，缺少足以安眠的夜晚。后来我才知道，苦难也可以诞生于丰饶，当酒水可以灌满所有人的杯盏，人们便开始争论谁的杯子更精美，当每一个夜晚都有灯火可亲，人们就开始计较谁的烛火更明亮。难道我们渴求的本就是痛苦？"

