[sub_resource type="Shader" id="Shader_edge_blend"]
code = "shader_type canvas_item;
uniform vec2 sprite_size = vec2(665.0, 665.0);
uniform vec4 fade_edges = vec4(0.0);
varying vec2 local_pixel;
void vertex() { local_pixel = VERTEX; }
void fragment() {
 float a = 1.0;
 if (fade_edges.x > 0.0) a *= smoothstep(0.0, fade_edges.x, local_pixel.x);
 if (fade_edges.y > 0.0) a *= smoothstep(0.0, fade_edges.y, local_pixel.y);
 if (fade_edges.z > 0.0) a *= smoothstep(0.0, fade_edges.z, sprite_size.x - local_pixel.x);
 if (fade_edges.w > 0.0) a *= smoothstep(0.0, fade_edges.w, sprite_size.y - local_pixel.y);
 COLOR.a *= a;
}
"

