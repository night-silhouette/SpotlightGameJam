[sub_resource type="Resource" id="Line_1_1"]
script = ExtResource("6_qv0jn")
dialog_type = "独白"
text = "这是哪里……"

[sub_resource type="Resource" id="Line_1_2"]
script = ExtResource("6_qv0jn")
dialog_type = "独白"
text = "好痛……身体像被火烧过一样……水，我需要水！"

[sub_resource type="Resource" id="Resource_yo42o"]
script = ExtResource("6_qv0jn")
text = "【靠近水源可快速补充水分】"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_bvdhl"]
script = ExtResource("6_qv0jn")
text = "水面的涟漪倒映出一张完全陌生的脸。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_abrb0"]
script = ExtResource("6_qv0jn")
dialog_type = "独白"
text = "这，这是我吗……脸上是什么……"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Line_1_4"]
script = ExtResource("6_qv0jn")
text = "冰凉舒缓的水滑入喉管。"

[sub_resource type="Resource" id="Line_1_5"]
script = ExtResource("6_qv0jn")
dialog_type = "独白"
text = "慢慢找回呼吸的节奏了，刚刚那种心脏快要干涸的感觉消失了……"

[sub_resource type="Resource" id="Line_1_6"]
script = ExtResource("6_qv0jn")
dialog_type = "独白"
text = "虽然不知道为什么，但看来得一直保持身体里的水分才行，一旦缺水，恐怕行动都会成问题。"

[sub_resource type="Resource" id="Reflection_enter_line"]
script = ExtResource("6_qv0jn")
text = "水面的涟漪倒映出一张完全陌生的脸。"

[sub_resource type="Resource" id="Line_1_8"]
script = ExtResource("6_qv0jn")
dialog_type = "独白"
text = "这，这是我吗……脸上是什么……"

[sub_resource type="Resource" id="Resource_tf67n"]
script = ExtResource("6_qv0jn")
dialog_type = "独白"
text = "不管怎样，看来我只能沿着这些线索继续走下去了。那么，先去画上人挥手的方向看看吧"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

