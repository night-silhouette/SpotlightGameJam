[sub_resource type="Resource" id="Resource_68lmy"]
script = ExtResource("6_qv0jn")
dialog_type = "独白"
text = "这帐篷……是用无数片颜色各异的碎布料拼凑缝补的。有人在这里生活过？"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_v13fp"]
resource_local_to_scene = true
size = Vector2(169.84523, 144.98253)

[sub_resource type="ShaderMaterial" id="ShaderMaterial_oslkj"]
resource_local_to_scene = true
shader = ExtResource("7_v13fp")
shader_parameter/progress = 0.0

[sub_resource type="AtlasTexture" id="AtlasTexture_camp_sky_extension"]
atlas = ExtResource("13_a07x8")
region = Rect2(0, 0, 2100, 700)
filter_clip = true

[sub_resource type="Resource" id="Line_1_1"]
script = ExtResource("6_qv0jn")
dialog_type = "独白"
text = "这是哪里……"

[sub_resource type="Resource" id="Line_1_2"]
script = ExtResource("6_qv0jn")
dialog_type = "独白"
text = "好痛……身体像被火烧过一样……水，我需要水！"

[sub_resource type="Resource" id="Resource_yo42o"]
script = ExtResource("6_qv0jn")
text = "【靠近水源可快速补充水分】"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_1khv5"]
script = ExtResource("6_qv0jn")
text = "残破的石碑，上方一行字，下方有刻痕形成的图案，经历了风吹日晒，还附着着很多沙土，均已有些模糊不清。图案是几个火柴人影，看起来像是高举手臂，整个身体向上延伸"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_wx588"]
script = ExtResource("6_qv0jn")
dialog_type = "独白"
text = "这上面有字，“寻找，直到最后XXXXX。”好难辨认，后面几个字几乎看不清了"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_na041"]
script = ExtResource("6_qv0jn")
dialog_type = "独白"
text = "还有……这是一幅画吗？画上的人在干什么，好像在朝着远处挥手？这些竖道又是什么……"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_0yts4"]
script = ExtResource("6_qv0jn")
dialog_type = "独白"
text = "这是谁留下的，为什么偏偏出现在这里？他似乎知道些什么……难道他也曾像我一样，不知何去何从……"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_tf67n"]
script = ExtResource("6_qv0jn")
dialog_type = "独白"
text = "不管怎样，看来我只能沿着这些线索继续走下去了。那么，先去画上人挥手的方向看看吧"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_k8pln"]
script = ExtResource("6_qv0jn")
text = "随着冰凉舒缓的水滑入喉管，刚刚那种心脏快要干涸的感觉消失了。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_a07x8"]
script = ExtResource("6_qv0jn")
text = "慢慢找回呼吸的节奏了……虽然不知道为什么，但看来得一直保持身体里的水分才行。一旦缺水，恐怕行动都会成问题。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

