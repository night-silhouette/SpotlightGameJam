[sub_resource type="Resource" id="C3_2_20"]
script = ExtResource("5_acpp2")
text = "一顶日轮冠。嵌在蛇身雕塑的头顶，仍保留着精巧而庄严的形制，冠体金色，纹饰层层舒展。"

[sub_resource type="Resource" id="C3_2_21"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "这似乎不是普通的装饰。它被如此郑重地安置在这里，还散发着一种说不清道不明的力量……
先带走吧，说不定之后会用得到。"

[sub_resource type="Resource" id="Resource_1p2nt"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "这里与外面的氛围完全不同，却不会让人觉得逼仄，反而有种……说不出的庄严……"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_terh4"]
script = ExtResource("5_acpp2")
text = "石桌上蒙着一层尘土。尘土之下，是几张繁复的星图。密密麻麻的星点与刻线，圆环层层套叠，还有绘制到一半，散落一旁。像是书写它们的人只是暂时离开了。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_hrpuy"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "好复杂……浩瀚的星芒之中，藏着怎样的答案？"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_0dlu5"]
script = ExtResource("5_acpp2")
text = "石桌上蒙着一层尘土。尘土之下，是几张繁复的星图。密密麻麻的星点与刻线，圆环层层套叠，还有绘制到一半，散落一旁。像是书写它们的人只是暂时离开了。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_ciajo"]
script = ExtResource("5_acpp2")
text = "黄铜制成的单片放大镜。静静躺在桌边，已失去光泽，但很精巧。试了试感觉很趁手。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_7posy"]
script = ExtResource("5_acpp2")
text = "黄铜制成的单片放大镜。静静躺在桌边，已失去光泽，但很精巧。试了试感觉很趁手。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_d0knf"]
script = ExtResource("5_acpp2")
text = "石面被打磨得近乎光滑，中央是一轮完整的满月，周围依次刻着盈亏不一的月相。月相周围，有细密的银白色刻痕。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_yq83x"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "这些月相之间的纹路……像是交织的河流，被什么无形之物牵引着。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_m8xep"]
script = ExtResource("5_acpp2")
text = "石面被打磨得近乎光滑，中央是一轮完整的满月，周围依次刻着盈亏不一的月相。月相周围，有细密的银白色刻痕。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_womvd"]
script = ExtResource("5_acpp2")
text = "展开的图册。与周围其他书卷不同，它没有密密麻麻的文字，只有一幅幅连续的图画。纸页边缘还留着被反复翻看的痕迹，扉页上写着：月族图书馆藏书。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_e17ub"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "都是图画，这是给小孩子看的吗？"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_4qq5m"]
script = ExtResource("5_acpp2")
text = "石碑立在书架之间，碑身布满细密的裂痕。岁月已经磨去了大半刻痕，唯有中央的一句话仍清晰可辨：“昼与夜相依，日与月相生。”"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_2x4ys"]
script = ExtResource("5_acpp2")
text = "石碑立在书架之间，碑身布满细密的裂痕。岁月已经磨去了大半刻痕，唯有中央的一句话仍清晰可辨：“昼与夜相依，日与月相生。”"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_r37dm"]
script = ExtResource("5_acpp2")
text = "封面已经褪色，纸页皱皱巴巴，边角也有点卷曲，显然曾被一次又一次翻阅。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="C3_2_1"]
script = ExtResource("5_acpp2")
text = "太阳在沙丘上留下了无名的城"

[sub_resource type="Resource" id="C3_2_2"]
script = ExtResource("5_acpp2")
text = "一座破败的宫殿半埋于炙热的黄沙之中。高大的石墙早已倾颓，断裂的石柱仍倔强地撑起残存的穹顶，但仍能看出这里旧日的恢宏。墙边留存着几处规整的蓄水池与水道。"

[sub_resource type="Resource" id="C3_2_3"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "这宫殿即使已经残破，依然能看出昔日的辉煌。"

[sub_resource type="Resource" id="C3_2_5"]
script = ExtResource("5_acpp2")
text = "许多陶罐。堆在墙角与石阶旁，大小不一，形制各异，罐身残留着褪色的纹饰。部分已经干燥破裂，边缘参差，裂纹密布。"

[sub_resource type="Resource" id="C3_2_6"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "这么多陶罐碎片，是用来储水的吧……曾经是。"

[sub_resource type="Resource" id="C3_2_7"]
script = ExtResource("5_acpp2")
text = "一些工具与农具散落在残墙边，长柄木器已朽坏，金属部分覆着厚厚的锈迹，边缘均已磨损。它们曾被频繁使用，如今却静静地躺在沙土之中。"

[sub_resource type="Resource" id="C3_2_8"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "这些工具和农具，有些形制简单，有些已有精巧的结构……不仅建造了这样庞大的宫殿，还曾开辟土地、耕种作物。在这片沙漠里要做到这些，并不容易。"

[sub_resource type="Resource" id="C3_2_10"]
script = ExtResource("5_acpp2")
text = "沿着高大的墙面铺展开的壁画。残缺不全。
画中，日族（蛇样）在烈日下筑起高墙，建造宫殿与蓄水设施。
另一侧，日族战士列阵出征，旌旗与兵刃交错。
画面逐渐延伸，接连几幅都是在描绘战场情景，日月轮换，晴雨交替，战役从白昼持续到黑夜，又从黑夜延续至白昼。
再往下，很多日族的民众聚在一起，围着宫殿，庆祝着什么。
最后一幅，映入眼帘的是一轮巨大的、比例失调的，甚至有些畸形的太阳，将原本的城池和族民都挤压到了底边。"

[sub_resource type="Resource" id="C3_2_11"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "奇怪……壁画怎么突然断了？
这太阳……让人有一种很不安的感觉，像是要将一切吞没。"

[sub_resource type="Resource" id="C3_2_12"]
script = ExtResource("5_acpp2")
text = "一堆铭牌散落在石桌边。边上刻着相似的纹饰与文字，部分铭文仍能辨认：日族先锋军。"

[sub_resource type="Resource" id="C3_2_13"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "这是为战死者准备的哀荣……怎么都堆在这里，没有分发出去呢？"

[sub_resource type="Resource" id="C3_2_14"]
script = ExtResource("5_acpp2")
text = "一张巨大的石桌。横亘在宫殿中央，桌面覆着一层厚重的沙土。桌沿雕刻着繁复的日轮纹饰，几处边角已经有崩裂的趋势。
桌面一侧有一片不自然的擦痕，露出了光滑的石面。"

[sub_resource type="Resource" id="C3_2_15"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "像是他们开会议事的地方。这里曾经有着相当完善的制度啊。"

[sub_resource type="Resource" id="C3_2_17"]
script = ExtResource("5_acpp2")
text = "一尊蛇身雕塑。矗立在石台之上，颜色已经被磨损殆尽，但轮廓完整。蛇身盘踞，昂首向天，充满神秘的压迫感。这是这片废墟里唯一保有完整形态的造物。"

[sub_resource type="Resource" id="C3_2_18"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "这地方到处是积尘，怎么这尊雕塑上却干干净净……咦？尾巴好像还被人反复修缮过。"

[sub_resource type="Resource" id="C3_2_19"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "啊！雕塑头顶的纹饰，和我脸上的一模一样……"

[sub_resource type="Resource" id="C3_2_22"]
script = ExtResource("5_acpp2")
text = "位于高处的巨型蓄水池发出一声低沉而绝望的轰鸣，竟突然崩塌。石板接连断裂，积蓄已久的水伴随着沙土与碎石倾泻而下，四周的地板随之急剧破裂，轰鸣声在空旷的城池间回荡。"

[sub_resource type="Resource" id="C3_2_23"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "得快点躲开！
这么多水，怎么会，这座城不是已经荒废了吗？"

[sub_resource type="Resource" id="C4_1"]
script = ExtResource("5_acpp2")
text = "绿洲从未竟的声声叹息中生长"

[sub_resource type="Resource" id="C4_2"]
script = ExtResource("5_acpp2")
text = "金色瀚海在此处骤然断截，层层叠叠的绿意涌到眼前。藤蔓攀缘，枝干交错，阳光在水面上留下细碎的鳞光。"

[sub_resource type="Resource" id="C4_4"]
script = ExtResource("5_acpp2")
text = "两把剑。剑刃已经锈蚀、断裂，剑柄上还留着不同的纹饰。它们曾经指向彼此，可现在植物根系已经将它们紧紧盘绕包裹在一起，如同一座铁墓碑。"

[sub_resource type="Resource" id="C4_5"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "它们的主人站在战场上时，一定坚信自己有挥剑的理由。如果仇恨与希望已经无从辨认，那么他们曾忍受的究竟是什么呢？"

[sub_resource type="Resource" id="C4_6"]
script = ExtResource("5_acpp2")
text = "半埋于泥土中的骨架，与葳蕤的草木浑然交融，若不细看会以为它们本就是这片土地的一部分。白骨丛间，奇异的发光植物肆意舒展，明灭起落，莹莹微光随风四散。"

[sub_resource type="Resource" id="C4_7"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "看来，这里就是那场最终战役的古战场了。那么多交错的白骨……究竟有多少人在此长眠？直到一切都被风沙吞没。不过奇怪的是，这里却并没有腐朽和绝望的气息。"

[sub_resource type="Resource" id="Resource_qpp1c"]
script = ExtResource("5_acpp2")
text = "诸多白骨之中，唯独有一具显得尤为奇异。半截枯骨露在土壤之外，骨面上分布着残缺的几何纹样，若隐若现的光芒沿着纹路缓缓流动。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_o0b1u"]
script = ExtResource("5_acpp2")
text = "无论怎么看，这具枯骨都不太对劲。把它拔出来……真的好吗？……算了，既然已经走到这里，就没有回头的理由。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="C4_17"]
script = ExtResource("5_acpp2")
text = "光点或浮游在风中，或沉入水面，或没入泥土，或停留在草木初生的叶稍。随着光点跳跃，细小的根须缓缓伸展，水流悄然汇聚。"

[sub_resource type="Resource" id="C4_18"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "原来这些绿洲是这样出现的……曾经水火不容的两族，那些愤怒的灵魂，连同他们遗留的血肉、骨骼，一同归还给了这片土地，孕育出了这片葱茏……"

[sub_resource type="Resource" id="C4_19"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "走吧，该离开这里了，把这片绿洲的故事……带回去。"

