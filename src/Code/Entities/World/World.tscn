[node name="敌人的定义_4_20" parent="story/c4" unique_id=861258208 instance=ExtResource("20_m8xep")]
position = Vector2(-6500, -210)
content = "《敌人的定义》
作者佚名
这场战争有两种开端。一种发生在战争之前，由边界、生命、恐惧和那些不会被兑现的承诺构成。另一种发生在战争之后，由演说家、祭祀和历史学家共同撰写。我看到了，对面有我的朋友。我说，我们曾相依为命，长官说，他们注定会背叛。原来敌人可以是一个与你素不相识的人，也可以是那个被要求忘记的人。"
display_duration = 12.0
trigger_relic = &"bones"
finished_chapter_channel = &"chapter5_after_enemy_definition"
metadata/_editor_description_ = "第四章尾声；本卡淡出隐藏后的 Finished 请求第五章卡。"

