[node name="PictureBook" parent="story/c2/残缺的绘本" unique_id=85174331 instance=ExtResource("17_picture_book")]
close_monologue_expressions = Dictionary[int, String]({0: "惊讶"})
pages = Array[String](["一页一页翻着，前半部分日族与月族一起出现，他们聊天、游戏、交换食物，画面看着暖融融的。", "可翻到最后几页，画面变了。笑脸被改成了哭脸，空着的手上被添上了刀剑和长矛。最后一页，原本似乎是一起庆祝节日的集会。但现在，每个人的表情都被改了。整张画上找不到一双笑的眼睛。"])
close_monologues = Array[String](["！这些月族人……有和我一样的耳朵和尾巴。", "他们曾毫无嫌隙地活在同一片天空下，后来呢，究竟发生了什么？"])

