[sub_resource type="Resource" id="Resource_1p2nt"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "这里的氛围与外面全然不同，却并不让人觉得逼仄，反而有一种……说不出的庄严。
"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_d0knf"]
script = ExtResource("5_acpp2")
text = "石面似乎经过了精细的打磨，摸起来很光滑。正中央刻着一轮完整的满月，周围依次是盈亏不一的月相，细密的银白色刻痕贯穿其间。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_yq83x"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "这些月相之间的纹路……像是交织的河流，被什么无形之物牵引着。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_m8xep"]
script = ExtResource("5_acpp2")
text = "石面被打磨得近乎光滑，中央是一轮完整的满月，周围依次刻着盈亏不一的月相。月相周围，有细密的银白色刻痕。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_womvd"]
script = ExtResource("5_acpp2")
text = "书脊上写着一行小字：月族图书馆藏书。翻开一看，原来是一本图册。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_e17ub"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "是给小孩子看的吗？"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_4qq5m"]
script = ExtResource("5_acpp2")
text = "石碑立在书架之间，碑身布满细密的裂痕。岁月已经磨去了大半刻痕，唯有中央的一句话仍清晰可辨：“昼与夜相依，日与月相生。”"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_2x4ys"]
script = ExtResource("5_acpp2")
text = "石碑立在书架之间，碑身布满细密的裂痕。岁月已经磨去了大半刻痕，唯有中央的一句话仍清晰可辨：“昼与夜相依，日与月相生。”"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_r37dm"]
script = ExtResource("5_acpp2")
text = "往书架深处探了探，摸到一本厚重的笔记，封面已经褪色，纸页皱皱巴巴，边角也有点卷，显然曾被反复翻阅过。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_hehhy"]
script = ExtResource("5_acpp2")
text = "往书架深处探了探，摸到一本厚重的笔记，封面已经褪色，纸页皱皱巴巴，边角也有点卷，显然曾被反复翻阅过。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_urly8"]
script = ExtResource("5_acpp2")
text = "桌边静静躺着一柄黄铜单片放大镜，已失去了光泽，却很精巧。拿起来试了试，意外地趁手。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_vqyf3"]
script = ExtResource("5_acpp2")
text = "桌边静静躺着一柄黄铜单片放大镜，已失去了光泽，却很精巧。拿起来试了试，意外地趁手。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_terh4"]
script = ExtResource("5_acpp2")
text = "石桌上蒙着薄薄的尘土，伸手拂开，露出几张繁复的星图。密密麻麻的星点与刻线，圆环层层套叠，有几张只绘制到一半，散落在旁，书写它们的人仿佛只是暂时离开。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_hrpuy"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "好复杂……浩瀚的星芒之中，藏着怎样的答案？"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_0dlu5"]
script = ExtResource("5_acpp2")
text = "石桌上蒙着一层尘土。尘土之下，是几张繁复的星图。密密麻麻的星点与刻线，圆环层层套叠，还有绘制到一半，散落一旁。像是书写它们的人只是暂时离开了。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_f6a4i"]
size = Vector2(137.25, 123)

[sub_resource type="Resource" id="C3_2_2"]
script = ExtResource("5_acpp2")
text = "一座矗立于茫茫黄沙之间的古老宫殿，逐渐映入眼帘。高耸的石墙历经风沙侵蚀，墙根堆积着厚厚的黄沙，部分墙体已经倾颓，但仍能从中窥见其旧日的恢宏气势。数条干涸的水道像一道道已经结痂的伤疤，安静地等在墙根。
"

[sub_resource type="Resource" id="C3_2_5"]
script = ExtResource("5_acpp2")
text = "许多陶罐堆在墙角与石阶旁，形制各异，罐身残留着褪色的纹饰，部分已经干燥破裂。
"

[sub_resource type="Resource" id="C3_2_6"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "是用来储水的吧……曾经是。
"

[sub_resource type="Resource" id="C3_2_7"]
script = ExtResource("5_acpp2")
text = "一些工具与农具散落在残墙边，木制长柄大多已朽坏，金属部分覆着层层锈迹。
"

[sub_resource type="Resource" id="C3_2_8"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "不仅建造了这样庞大的宫殿，还开辟土地、耕种作物。在这片沙漠里要做到这些，并不容易。
"

[sub_resource type="Resource" id="C3_2_10"]
script = ExtResource("5_acpp2")
text = "往里走去，一幅沿着高大墙面铺展开的壁画徐徐浮现。
"

[sub_resource type="Resource" id="C3_2_11"]
script = ExtResource("5_acpp2")
text = "画中的日族族民们在烈日下筑起高墙，修建宫殿与蓄水设施。另一侧，战士们似乎要列阵出征，旌旗猎猎，兵刃交错。
"

[sub_resource type="Resource" id="Resource_ob0il"]
script = ExtResource("5_acpp2")
text = "画面向前延伸，接连数幅皆是战场的景象。日月轮换，晴雨交替，战火始终未曾停歇。
"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_2hkl3"]
script = ExtResource("5_acpp2")
text = "再往下看，许多日族民众聚集在宫殿周围，似乎正在举行一场盛大的庆典。
"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_0jqti"]
script = ExtResource("5_acpp2")
text = "最后一幅，一轮巨大得近乎失真的太阳占据了大半画面，将下方的城池与族民都逼至了画面的边缘。
"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_k5nmj"]
script = ExtResource("5_acpp2")
text = "壁画在此处戛然而止，所有该流向结局的线条，都停在了这面残壁上。
"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_kdjvc"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
monologue_expression = "惊讶"
text = "这太阳……让人有一种很不安的感觉，像是要将一切吞没。"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="C3_2_12"]
script = ExtResource("5_acpp2")
text = "一堆铭牌散落在石桌边，刻着相同的纹饰，翻到背面，部分铭文仍能辨认。
"

[sub_resource type="Resource" id="C3_2_13"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "“日族先锋军”……这是为战死者准备的哀荣……为什么没有分发出去呢？
"

[sub_resource type="Resource" id="C3_2_14"]
script = ExtResource("5_acpp2")
text = "一张巨大的议政桌横亘在宫殿中央，桌面上覆着一层厚重的沙土，几处边角已经有崩裂的趋势。但桌角有一片突兀的扇形擦痕，露出了光滑的石面。
"

[sub_resource type="Resource" id="C3_2_15"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "曾经有着相当完善的制度啊——欸？这是……
"

[sub_resource type="Resource" id="C3_2_17"]
script = ExtResource("5_acpp2")
text = "一尊蛇身雕塑矗立在石台之上，蛇身盘踞，昂首向天。表面的颜色早已磨损殆尽，面目却依旧活灵活现，神情矜贵而威严。
"

[sub_resource type="Resource" id="C3_2_18"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "尾巴尖好像还被反复修缮过……
"

[sub_resource type="Resource" id="C3_2_19"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
monologue_expression = "惊讶"
text = "啊！雕塑头顶的纹饰，和我脸上的一模一样……"

[sub_resource type="Resource" id="C4_2"]
script = ExtResource("5_acpp2")
text = "金色瀚海在此处骤然断截，行舟渡湖，层层叠叠的绿意涌到眼前。藤蔓攀缘，枝干交错，阳光在水面上洒下细碎的鳞光。
"

[sub_resource type="Resource" id="C4_4"]
script = ExtResource("5_acpp2")
text = "剑刃已经锈蚀、断裂，剑柄上还留着不同的纹饰。它们曾经指向彼此，如今却被植物的根系紧紧缠绕、包裹在一起，如同一座铁铸的墓碑。
"

[sub_resource type="Resource" id="C4_5"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "它们的主人站在战场上时，一定坚信自己有挥剑的理由。如果仇恨与希望已无从分辨，那么他们曾忍受的究竟是什么呢？
"

[sub_resource type="Resource" id="C4_6"]
script = ExtResource("5_acpp2")
text = "半埋于泥土中的骨架，与葳蕤的草木浑然交融，若不细看，会以为它们本就是这片土地的一部分。白骨丛间，奇异的发光植物肆意舒展，明灭起落，莹莹微光随风四散。
"

[sub_resource type="Resource" id="C4_7"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "看来，这里就是那场最终战役的战场了。那么多交错的白骨……不敢想象，有多少战士在此长眠？曾经旌旗蔽日，刀兵相接，喊杀声与哀号声此起彼伏。直到……直到一切都被风沙吞没。
"

[sub_resource type="Resource" id="Resource_4onqo"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
monologue_expression = "平静"
text = "不过奇怪的是，这里并没有腐朽和绝望的气息。
"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_qpp1c"]
script = ExtResource("5_acpp2")
text = "诸多白骨之中，唯有这截格外奇异。它边缘有不规则的磨损痕迹，骨面上分布着残缺的几何纹样。若隐若现的光芒从斑驳的刻痕间隐约透出，沿着纹路缓缓流动。
"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_o0b1u"]
script = ExtResource("5_acpp2")
text = "靠近后，隐约有低语自骨头深处传来。骨缝钻出的嫩芽在风中颤抖，像是在阻止，又像是在渴求着什么。
"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="Resource_6ywoy"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "无论怎么看，这具枯骨都不太对劲。把它拔出来真的好吗？……算了，既然已经走到这里，就没有回头的理由。
"
metadata/_custom_type_script = "uid://bfra5n80onwqv"

[sub_resource type="Resource" id="C4_17"]
script = ExtResource("5_acpp2")
text = "光点或浮游在风中，或沉入水面，或没入泥土，或停留在草木初生的叶稍。随着光点跳跃，细小的根须缓缓伸展，水流悄然汇聚。"

[sub_resource type="Resource" id="C4_18"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
monologue_expression = "平静"
text = "原来这些绿洲是这样出现的……曾经水火不容的两族，那些愤怒的灵魂，连同他们遗留的血肉、骨骼，一同归还给了这片土地，孕育出了这片葱茏……"

[sub_resource type="Resource" id="C4_19"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "走吧，该离开这里了，把这片绿洲的故事……带回去。"

