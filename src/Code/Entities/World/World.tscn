[sub_resource type="Resource" id="C3_2_20"]
script = ExtResource("5_acpp2")
text = "蛇身雕塑附近掉落着一顶王冠，通体鎏金，刻着繁复而规整的纹饰，仍保留着庄严而肃穆的形制，散发着一种神秘的威严。"

[sub_resource type="Resource" id="C3_2_21"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
text = "这王冠散发着一种说不清道不明的力量，似乎不是普通的装饰品。"

[sub_resource type="Resource" id="C3_2_21_b"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
monologue_expression = "平静"
text = "……先带走吧，感觉之后会用得到呢。"

[sub_resource type="Resource" id="C3_2_22"]
script = ExtResource("5_acpp2")
text = "突然，位于高处的巨型蓄水池发出一声低沉而绝望的悲鸣，随即崩塌。积蓄已久的水裹挟着沙土与碎石倾泻而下，脚下的地板也随之崩裂，轰鸣声在殿宇间来回冲撞。"

[sub_resource type="Resource" id="C3_2_23"]
script = ExtResource("5_acpp2")
dialog_type = "独白"
monologue_expression = "惊讶"
text = "得快点躲开！
这么多水，怎么会……这里不是已经荒废了吗？"

