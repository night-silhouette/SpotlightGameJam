[sub_resource type="Shader" id="Shader_low_water_outline"]
code = "shader_type canvas_item;

uniform vec4 outline_color : source_color = vec4(0.0, 0.0, 0.0, 1.0);
uniform float outline_strength : hint_range(0.0, 1.0) = 0.0;
uniform float outline_width : hint_range(1.0, 8.0) = 3.0;
uniform float edge_damage : hint_range(0.0, 0.5) = 0.16;

float pixel_noise(vec2 pixel_position) {
	return fract(sin(dot(pixel_position, vec2(12.9898, 78.233))) * 43758.5453);
}

void fragment() {
	vec4 base_color = COLOR;
	vec2 offset = TEXTURE_PIXEL_SIZE * outline_width;
	float neighbor_alpha = min(
		min(texture(TEXTURE, UV + vec2(offset.x, 0.0)).a, texture(TEXTURE, UV - vec2(offset.x, 0.0)).a),
		min(texture(TEXTURE, UV + vec2(0.0, offset.y)).a, texture(TEXTURE, UV - vec2(0.0, offset.y)).a)
	);
	float edge = base_color.a * (1.0 - neighbor_alpha) * outline_strength;
	float noise = pixel_noise(floor(UV / TEXTURE_PIXEL_SIZE));
	float rough_edge = edge * mix(0.55, 1.0, noise);
	float chip = edge * step(1.0 - edge_damage, noise);
	base_color.rgb = mix(base_color.rgb, outline_color.rgb, rough_edge * outline_color.a);
	base_color.a *= 1.0 - chip * 0.85;
	COLOR = base_color;
}
"

