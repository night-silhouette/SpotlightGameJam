texture = ExtResource("19_scholars_notebook")

[node name="ScholarNotebook" parent="story/c2/学者的笔记" unique_id=137594361 instance=ExtResource("17_picture_book")]
book_title = "学者的笔记"
pages = Array[String](["我们曾经共同生活在这片土地上。日族守护白昼，在阳光下耕种、劳作；月族行走长夜，循着月色寻找水源。
没有人问水属于谁。因为所有人都知道，水若不能流动，便无法抵达需要它的地方。水像一条看不见的线，将昼与夜缝在一起，我们从未觉得彼此有什么不同。", "最初，我们只是拥有不同的分工。后来，白昼与长夜，将我们带向不同的道路，也让我们渐渐习惯只与自己的族人同行。我们开始用不同的名字称呼自己，自然而然形成了界限，我们站在这界限的两边，互相推搡。", "后来，我们惊讶地发现昼与夜并非永恒。日族越强，白昼便越长；月族越强，长夜便越长。若让另一方永远消失，世界是否就永远属于我们？当第一次有人指出这问题时，一切都失控了。", "可这个世界不属于日，也不属于月。昼与夜彼此成全，水与土地相互依存。一方存在的意义，从来都不在自己之中。可当我终于看清这一点时，已经太迟了。", "决战只剩两日。世界将会朝一边倾覆，而另一边同样得不到幸福。", "他们同时拥有……同生于这片天地……新世界……"])
page_monologues = Array[String](["", "", "原来如此……", "", "日族宫殿里的痕迹，还有这里留下的文字，都在讲同一场战争。那场战争，月族战败了，世界也不再是原来的世界了。", "欸？这页内容好模糊……看不懂啊，这说的是我吗？可‘他们’是什么意思？还有很多和我一样的人吗"])
close_monologues = Array[String]([])

[node name="GradualTextTrigger" parent="story/c2" unique_id=1879339704 instance=ExtResource("20_m8xep")]
position = Vector2(875, 2406.0002)
scale = Vector2(2.2155194, 0.55301255)
content = "《水的法则》
作者佚名
水从不拒绝任何容器，它流入王的金盏，也流入乞丐的掌心，若将他倒入墓穴，它便与死者共处，若将它引入宫殿，它也不会因此变得高贵。可水的来处，水的名字，却成了使自己凌驾于他人之上的证明。他们争论，倘若一人编织牢笼，一人引鸟入笼，谁才是它的主人？幸好，水不会因这些语句就停止流动"
display_duration = 9.9

