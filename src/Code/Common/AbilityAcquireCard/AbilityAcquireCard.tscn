render_mode unshaded;
uniform vec4 paper_color : source_color = vec4(0.894118, 0.847059, 0.72549, 1.0);
varying vec4 tint;
void vertex() {
	tint = COLOR;
}
void fragment() {
	COLOR = vec4(paper_color.rgb, texture(TEXTURE, UV).a * paper_color.a) * tint;
}
"

